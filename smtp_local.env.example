# Copy this file to smtp_local.env and fill in (smtp_local.env is gitignored).
# Gmail: Account → Security → 2-Step Verification → App passwords → create for "Mail".

OLFACTO_SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional if you send from a different address than the default:
# OLFACTO_SMTP_FROM=your.lab@gmail.com
